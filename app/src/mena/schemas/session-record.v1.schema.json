{
  "$id": "https://dothackerman.github.io/mena/schemas/session-record.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "audio_route": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "description": {
          "type": ["string", "null"]
        },
        "id": {
          "minimum": 0,
          "type": "integer"
        },
        "media_class": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "node_name": {
          "type": ["string", "null"]
        },
        "object_serial": {
          "type": ["string", "null"]
        },
        "pw_record_target": {
          "type": ["string", "null"]
        },
        "route_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["id", "route_id", "name", "description", "media_class", "active"],
      "type": "object"
    },
    "capture_metadata": {
      "additionalProperties": false,
      "description": "Capture facts emitted by the worker and persisted by the orchestrator.",
      "properties": {
        "channels": {
          "minimum": 1,
          "type": "integer"
        },
        "profile": {
          "enum": ["online_dual_stream", "in_person_single_mic"],
          "type": "string"
        },
        "sample_rate": {
          "minimum": 1,
          "type": "integer"
        },
        "segment_count": {
          "minimum": 0,
          "type": "integer"
        },
        "segment_seconds": {
          "minimum": 1,
          "type": "integer"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/capture_segment"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/capture_source_summary"
          },
          "type": "array"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "profile",
        "sample_rate",
        "channels",
        "segment_seconds",
        "segment_count",
        "segments",
        "sources"
      ],
      "type": "object"
    },
    "capture_plan": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "minLength": 1,
          "type": "string"
        },
        "profile": {
          "enum": ["online_dual_stream", "in_person_single_mic"],
          "type": "string"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/capture_route_binding"
          },
          "type": "array"
        },
        "segment_seconds": {
          "minimum": 1,
          "type": "integer"
        },
        "selected_sources": {
          "items": {
            "enum": ["local_mic", "system_audio", "room_mic"],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": ["planned", "active", "finalized", "interrupted_partial", "failed"],
          "type": "string"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "profile",
        "language",
        "segment_seconds",
        "selected_sources",
        "routes",
        "status"
      ],
      "type": "object"
    },
    "capture_route_binding": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "minLength": 1,
          "type": "string"
        },
        "backend_name": {
          "type": ["string", "null"]
        },
        "backend_target": {
          "type": ["string", "null"]
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "node_name": {
          "type": ["string", "null"]
        },
        "object_serial": {
          "type": ["string", "null"]
        },
        "required": {
          "type": "boolean"
        },
        "role": {
          "enum": ["microphone", "playback_stream", "output_sink"],
          "type": "string"
        },
        "route_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "enum": ["local_mic", "system_audio", "room_mic", null],
          "type": ["string", "null"]
        },
        "sink_input_id": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "role",
        "source_id",
        "route_id",
        "label",
        "backend",
        "backend_name",
        "required"
      ],
      "type": "object"
    },
    "capture_segment": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "minimum": 0,
          "type": "integer"
        },
        "channel_layout": {
          "minLength": 1,
          "type": "string"
        },
        "channels": {
          "minimum": 1,
          "type": "integer"
        },
        "duration_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "ended_at": {
          "format": "date-time",
          "type": ["string", "null"]
        },
        "format": {
          "const": "wav",
          "type": "string"
        },
        "index": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sample_format": {
          "minLength": 1,
          "type": "string"
        },
        "sample_rate": {
          "minimum": 1,
          "type": "integer"
        },
        "capture_mode": {
          "enum": ["selected_microphone", "dedicated_route", "system_mix_remote", null],
          "type": ["string", "null"]
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "route_id": {
          "type": ["string", "null"]
        },
        "route_label": {
          "type": ["string", "null"]
        },
        "source_id": {
          "enum": ["local_mic", "system_audio", "room_mic"],
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "type": ["string", "null"]
        },
        "status": {
          "enum": ["sealed", "partial", "failed"],
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "index",
        "path",
        "sample_rate",
        "channels",
        "channel_layout",
        "sample_format",
        "byte_count",
        "duration_seconds",
        "started_at",
        "ended_at",
        "sha256",
        "route_id",
        "route_label",
        "capture_mode",
        "status",
        "format"
      ],
      "type": "object"
    },
    "capture_source_summary": {
      "additionalProperties": false,
      "properties": {
        "channel_layout": {
          "minLength": 1,
          "type": "string"
        },
        "capture_mode": {
          "enum": ["selected_microphone", "dedicated_route", "system_mix_remote", null],
          "type": ["string", "null"]
        },
        "route_id": {
          "type": ["string", "null"]
        },
        "route_label": {
          "type": ["string", "null"]
        },
        "segment_count": {
          "minimum": 0,
          "type": "integer"
        },
        "source_id": {
          "enum": ["local_mic", "system_audio", "room_mic"],
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "route_id",
        "route_label",
        "capture_mode",
        "channel_layout",
        "segment_count"
      ],
      "type": "object"
    },
    "degradation": {
      "additionalProperties": false,
      "properties": {
        "capture_mode": {
          "enum": ["selected_microphone", "dedicated_route", "system_mix_remote", null],
          "type": ["string", "null"]
        },
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "elapsed_seconds": {
          "minimum": 0,
          "type": ["number", "null"]
        },
        "event": {
          "enum": ["degraded", "recovered"],
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "type": ["string", "null"]
        },
        "source_id": {
          "enum": ["local_mic", "system_audio", "room_mic", null],
          "type": ["string", "null"]
        },
        "route_id": {
          "type": ["string", "null"]
        },
        "route_label": {
          "type": ["string", "null"]
        },
        "segment_index": {
          "minimum": 1,
          "type": ["integer", "null"]
        }
      },
      "required": [
        "event",
        "code",
        "message",
        "source_id",
        "occurred_at",
        "elapsed_seconds",
        "segment_index",
        "route_id",
        "route_label",
        "capture_mode"
      ],
      "type": "object"
    },
    "failure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "type": ["string", "null"]
        },
        "recoverable": {
          "type": "boolean"
        },
        "source_id": {
          "enum": ["local_mic", "system_audio", "room_mic", null],
          "type": ["string", "null"]
        }
      },
      "required": ["code", "message", "source_id", "occurred_at", "recoverable"],
      "type": "object"
    },
    "playback_stream": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "app_binary_name": {
          "type": ["string", "null"]
        },
        "id": {
          "minimum": 0,
          "type": "integer"
        },
        "media_name": {
          "type": ["string", "null"]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "route_id": {
          "minLength": 1,
          "type": "string"
        },
        "sink_input_id": {
          "type": ["string", "null"]
        },
        "stream_name": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "id",
        "route_id",
        "name",
        "app_binary_name",
        "stream_name",
        "media_name",
        "sink_input_id",
        "active"
      ],
      "type": "object"
    },
    "recording": {
      "additionalProperties": false,
      "properties": {
        "finalization": {
          "$ref": "#/$defs/recording_finalization"
        },
        "started_at": {
          "format": "date-time",
          "type": ["string", "null"]
        },
        "stop_reason": {
          "enum": ["user_stop", "orchestrator_eof", "interrupted", "error", null]
        },
        "stopped_at": {
          "format": "date-time",
          "type": ["string", "null"]
        }
      },
      "required": ["started_at", "stopped_at", "stop_reason", "finalization"],
      "type": "object"
    },
    "recording_finalization": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "type": ["string", "null"]
        },
        "error": {
          "type": ["string", "null"]
        },
        "status": {
          "enum": ["not_started", "pending", "finalized", "interrupted_partial", "failed"],
          "type": "string"
        }
      },
      "required": ["status", "completed_at", "error"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical session record written by `mena record`.",
  "properties": {
    "capture_metadata": {
      "$ref": "#/$defs/capture_metadata"
    },
    "capture_plan": {
      "oneOf": [
        {
          "$ref": "#/$defs/capture_plan"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "description": "UTC session creation timestamp.",
      "format": "date-time",
      "type": "string"
    },
    "degradations": {
      "items": {
        "$ref": "#/$defs/degradation"
      },
      "type": "array"
    },
    "discovery": {
      "additionalProperties": false,
      "description": "Read-only audio discovery facts captured by the orchestrator.",
      "properties": {
        "error": {
          "type": ["string", "null"]
        },
        "playback_streams": {
          "items": {
            "$ref": "#/$defs/playback_stream"
          },
          "type": "array"
        },
        "profile": {
          "enum": ["online_dual_stream", "in_person_single_mic"],
          "type": "string"
        },
        "sinks": {
          "items": {
            "$ref": "#/$defs/audio_route"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/audio_route"
          },
          "type": "array"
        },
        "status": {
          "enum": ["available", "unavailable"],
          "type": "string"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": ["version", "profile", "status", "sources", "sinks", "playback_streams", "error"],
      "type": "object"
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/failure"
      },
      "type": "array"
    },
    "id": {
      "description": "Stable session UUID.",
      "format": "uuid",
      "type": "string"
    },
    "language": {
      "description": "Record-time meeting language used as downstream source of truth.",
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "description": "Optional human-facing session label.",
      "type": ["string", "null"]
    },
    "profile": {
      "description": "Durable architecture capture profile identifier.",
      "enum": ["online_dual_stream", "in_person_single_mic"],
      "type": "string"
    },
    "recording": {
      "$ref": "#/$defs/recording"
    },
    "status": {
      "description": "Session recording lifecycle state.",
      "enum": ["created", "recording", "recorded", "interrupted_partial", "failed"],
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Session Record schema version.",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "id",
    "created_at",
    "name",
    "status",
    "profile",
    "language",
    "recording",
    "capture_plan",
    "degradations",
    "failures"
  ],
  "title": "Mena Session Record v1",
  "type": "object"
}
