{
  "$id": "https://dothackerman.github.io/mena/schemas/session-record.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "audio_route": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "description": {
          "type": ["string", "null"]
        },
        "id": {
          "minimum": 0,
          "type": "integer"
        },
        "media_class": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "route_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["id", "route_id", "name", "description", "media_class", "active"],
      "type": "object"
    },
    "capture_segment": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "minimum": 0,
          "type": "integer"
        },
        "channels": {
          "minimum": 1,
          "type": "integer"
        },
        "format": {
          "const": "wav",
          "type": "string"
        },
        "index": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sample_rate": {
          "minimum": 1,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_id": {
          "enum": ["local_mic", "system_audio", "room_mic"],
          "type": "string"
        },
        "status": {
          "const": "sealed",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "index",
        "path",
        "sample_rate",
        "channels",
        "byte_count",
        "sha256",
        "status",
        "format"
      ],
      "type": "object"
    },
    "playback_stream": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "app_binary_name": {
          "type": ["string", "null"]
        },
        "id": {
          "minimum": 0,
          "type": "integer"
        },
        "media_name": {
          "type": ["string", "null"]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "route_id": {
          "minLength": 1,
          "type": "string"
        },
        "sink_input_id": {
          "type": ["string", "null"]
        },
        "stream_name": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "id",
        "route_id",
        "name",
        "app_binary_name",
        "stream_name",
        "media_name",
        "sink_input_id",
        "active"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Initial canonical session record written by `mena record`.",
  "properties": {
    "capture_metadata": {
      "additionalProperties": true,
      "description": "Capture facts emitted by the worker and persisted by the orchestrator.",
      "properties": {
        "channels": {
          "minimum": 1,
          "type": "integer"
        },
        "sample_rate": {
          "minimum": 1,
          "type": "integer"
        },
        "segment_count": {
          "minimum": 0,
          "type": "integer"
        },
        "segment_seconds": {
          "minimum": 1,
          "type": "integer"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/capture_segment"
          },
          "type": "array"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": ["version", "sample_rate", "channels", "segment_seconds", "segment_count", "segments"],
      "type": "object"
    },
    "created_at": {
      "description": "UTC session creation timestamp.",
      "format": "date-time",
      "type": "string"
    },
    "discovery": {
      "additionalProperties": true,
      "description": "Read-only audio discovery facts captured by the orchestrator.",
      "properties": {
        "error": {
          "type": ["string", "null"]
        },
        "playback_streams": {
          "items": {
            "$ref": "#/$defs/playback_stream"
          },
          "type": "array"
        },
        "profile": {
          "enum": ["online_dual_stream", "in_person_single_mic"],
          "type": "string"
        },
        "sinks": {
          "items": {
            "$ref": "#/$defs/audio_route"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/audio_route"
          },
          "type": "array"
        },
        "status": {
          "enum": ["available", "unavailable"],
          "type": "string"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": ["version", "profile", "status", "sources", "sinks", "playback_streams", "error"],
      "type": "object"
    },
    "id": {
      "description": "Stable session UUID.",
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "Optional human-facing session label.",
      "type": ["string", "null"]
    },
    "profile": {
      "description": "Durable architecture capture profile identifier.",
      "enum": ["online_dual_stream", "in_person_single_mic"],
      "type": "string"
    },
    "status": {
      "const": "created",
      "description": "Initial lifecycle state for a newly created session.",
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Session Record schema version.",
      "type": "integer"
    }
  },
  "required": ["version", "id", "created_at", "name", "status", "profile"],
  "title": "Mena Session Record v1",
  "type": "object"
}
