{
  "$id": "https://dothackerman.github.io/mena/schemas/artifact-manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifact_record": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_:-]*$",
          "type": "string"
        },
        "byte_count": {
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "path": {
          "minLength": 1,
          "pattern": "^artifacts/.+",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "status": {
          "enum": ["sealed", "staged", "failed"],
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "session_id",
        "artifact_type",
        "version",
        "path",
        "byte_count",
        "sha256",
        "status",
        "metadata"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Session-scoped artifact manifest written by the Artifact Store Port.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifact_record"
      },
      "type": "array"
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": ["version", "session_id", "artifacts"],
  "title": "Mena Artifact Manifest v1",
  "type": "object"
}
