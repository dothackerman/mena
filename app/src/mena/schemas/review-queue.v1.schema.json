{
  "$id": "https://dothackerman.github.io/mena/schemas/review-queue.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifact_ref": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "pattern": "^[a-z][a-z0-9_:-]*$",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": ["id", "artifact_type", "version", "sha256"],
      "type": "object"
    },
    "flag": {
      "additionalProperties": false,
      "properties": {
        "end_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_:-]*$",
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "reason_code": {
          "enum": [
            "low_transcription_confidence",
            "low_speaker_confidence",
            "speaker_overlap",
            "semantic_incoherence"
          ],
          "type": "string"
        },
        "segment_id": {
          "pattern": "^[a-z][a-z0-9_:-]*$",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_:-]*$",
          "type": "string"
        },
        "speaker_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_seconds": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "segment_id",
        "reason_code",
        "start_seconds",
        "end_seconds",
        "source_id",
        "speaker_id",
        "metadata"
      ],
      "type": "object"
    },
    "confidence_policy": {
      "additionalProperties": false,
      "properties": {
        "flag_unavailable_speaker_confidence": {
          "type": "boolean"
        },
        "min_avg_logprob": {
          "type": "number"
        },
        "min_speaker_overlap_ratio": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "min_word_probability": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "policy_version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "policy_version",
        "min_word_probability",
        "min_avg_logprob",
        "min_speaker_overlap_ratio",
        "flag_unavailable_speaker_confidence"
      ],
      "type": "object"
    },
    "semantic_policy": {
      "additionalProperties": false,
      "properties": {
        "context_window_segments": {
          "minimum": 0,
          "type": "integer"
        },
        "min_flag_confidence": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "policy_version": {
          "const": 1,
          "type": "integer"
        },
        "prompt_policy": {
          "minLength": 1,
          "type": "string"
        },
        "provider_config_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "policy_version",
        "context_window_segments",
        "min_flag_confidence",
        "prompt_policy",
        "provider_config_id"
      ],
      "type": "object"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/confidence_policy"
        },
        {
          "$ref": "#/$defs/semantic_policy"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "Versioned review queue artifact emitted by the confidence-based flagging stage.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "flags": {
      "items": {
        "$ref": "#/$defs/flag"
      },
      "type": "array"
    },
    "merged_transcript_artifact": {
      "$ref": "#/$defs/artifact_ref"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "session_id",
    "merged_transcript_artifact",
    "policy",
    "flags",
    "created_at"
  ],
  "type": "object"
}
