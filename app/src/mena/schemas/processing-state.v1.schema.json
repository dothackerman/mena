{
  "$id": "https://dothackerman.github.io/mena/schemas/processing-state.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifact_ref": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "pattern": "^[a-z][a-z0-9_:-]*$",
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": ["id", "artifact_type", "version", "sha256"],
      "type": "object"
    },
    "processing_error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": ["message", "retryable", "code"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned processing stage checkpoint state.",
  "properties": {
    "attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/processing_error"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_artifacts": {
      "items": {
        "$ref": "#/$defs/artifact_ref"
      },
      "type": "array"
    },
    "output_artifacts": {
      "items": {
        "$ref": "#/$defs/artifact_ref"
      },
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    },
    "skip_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": ["pending", "running", "completed", "failed", "skipped"],
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "session_id",
    "run_id",
    "stage",
    "status",
    "input_artifacts",
    "output_artifacts",
    "started_at",
    "completed_at",
    "error",
    "attempt"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        }
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "error": {
            "type": "null"
          },
          "skip_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "completed_at": {
            "format": "date-time",
            "type": "string"
          },
          "error": {
            "type": "null"
          },
          "skip_reason": {
            "type": "null"
          },
          "output_artifacts": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "completed_at": {
            "format": "date-time",
            "type": "string"
          },
          "error": {
            "$ref": "#/$defs/processing_error"
          },
          "skip_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "skipped"
          }
        }
      },
      "then": {
        "properties": {
          "completed_at": {
            "format": "date-time",
            "type": "string"
          },
          "error": {
            "type": "null"
          },
          "skip_reason": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  ],
  "title": "Mena Processing State v1",
  "type": "object"
}
